{
  "name": "vscode-h5web",
  "displayName": "H5Web (fork)",
  "publisher": "NAThompson",
  "description": "Visualize HDF5 files in VS Code (fork: lazy reading of huge files, wasm64)",
  "version": "0.3.0",
  "author": "European Synchrotron Radiation Facility",
  "license": "MIT",
  "homepage": "https://h5web.panosc.eu/",
  "repository": {
    "type": "git",
    "url": "https://github.com/NAThompson/vscode-h5web.git"
  },
  "bugs": {
    "url": "https://github.com/NAThompson/vscode-h5web/issues"
  },
  "icon": "assets/favicon192.png",
  "galleryBanner": {
    "color": "#333333",
    "theme": "dark"
  },
  "categories": [
    "Visualization"
  ],
  "engines": {
    "node": "24.x",
    "pnpm": "11.x",
    "vscode": ">=1.100.0"
  },
  "type": "module",
  "contributes": {
    "customEditors": [
      {
        "viewType": "h5web.viewer",
        "displayName": "H5Web",
        "selector": [
          {
            "filenamePattern": "*.{h5,hdf,hdf5,hf5,nx,nxs,nx5,nexus,cxi,nc,nc4,loom,jld2,h5ebsd,edaxh5,oh5,dream3d,geoh5,h5oina,h5ad,nde}"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "h5web.fallback-viewer",
        "displayName": "H5Web (any extension)",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "configuration": {
      "title": "H5Web",
      "properties": {
        "h5web.colorScheme": {
          "description": "Specifies whether to use a light or dark color scheme. By default, follow VS Code's theme. Alternatively, follow the operating system's scheme or force a specific scheme.",
          "type": "string",
          "default": "vscode",
          "enum": [
            "vscode",
            "system",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow VS Code's theme",
            "Follow the system's color scheme",
            "Use a light color scheme",
            "Use a dark color scheme"
          ]
        }
      }
    }
  },
  "main": "./out/main.js",
  "scripts": {
    "build": "pnpm build:app && pnpm clean:extension && pnpm build:extension --minify",
    "build:app": "vite build",
    "clean:extension": "node -e \"fs.rmSync('out', { recursive: true, force: true })\"",
    "build:extension": "esbuild ./extension/index.ts --bundle --outfile=out/main.js --external:vscode --loader:.so=file --format=esm --platform=node",
    "watch": "pnpm build:extension --sourcemap --watch",
    "lint": "pnpm \"/^lint:/\"",
    "lint:eslint": "eslint --max-warnings=0",
    "lint:prettier": "prettier --cache --check .",
    "vscode:prepublish": "pnpm build",
    "pub": "pnpm --allow-build=@vscode/vsce-sign --allow-build=keytar dlx @vscode/vsce publish --no-dependencies",
    "pub:ovsx": "pnpm --allow-build=@vscode/vsce-sign --allow-build=keytar dlx ovsx publish --no-dependencies"
  },
  "dependencies": {
    "@h5web/app": "file:vendor/h5web-app-18.0.0-beta.3-93ab5ad.tgz",
    "@h5web/h5wasm": "file:vendor/h5web-h5wasm-18.0.0-beta.3-93ab5ad.tgz",
    "@react-hookz/web": "26.1.0",
    "h5wasm-plugins": "file:vendor/h5wasm-plugins-0.3.0-wasm64-4677c68.tgz",
    "modern-normalize": "3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.2",
    "suspend-react": "0.1.3"
  },
  "devDependencies": {
    "@esrf/eslint-config": "2.3.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.100.0",
    "@types/vscode-webview": "~1.57.5",
    "@vitejs/plugin-react": "6.0.1",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vite": "8.0.7"
  }
}
